# yunzone-infer server 环境变量样例（复制为 .env 后填写；.env 禁止入库）
# 生态集成经 service-kit /config env facets（DESIGN §5）

# ── 部署面（D11 自托管 standalone；service-kit resolveListenAddress）──
PORT=3002
HOST=0.0.0.0

# ── 鉴权中心（/auth：推理请求 / 管理面 / provider 登录）──
AUTH_CENTER_BASE_URL=

# ── 管理控制台（/ops/next requireAdminAuth）──
ADMIN_PASSWORD=

# ── 用户中心 / 积分（/points deduct 消费侧 + deposit 产出侧，见 docs/deposit-model.md）──
UC_BASE_URL=
# B 端服务凭证；其 productId 须在 uc INTERNAL_DEPOSIT_PRODUCTS 白名单内方可调 deposit
INFER_SERVICE_CREDENTIAL=

# ── 数据库（/db：Ledger / 注册信息 / 工作流状态 / infer 内部积分台账）──
DATABASE_URL=

# ── 执行面 sidecar IPC（D16：HTTP over loopback TCP + 每次启动随机 token）──
# 0 = 随机端口，server 拉起 sidecar 后回读；SIDECAR_TOKEN 由 server 启动时随机生成注入，勿在此固定
SIDECAR_PORT=0

# ── 对象存储（/storage：DCIr 打包模型产物；D20 控制面签发预签名 URL 供 client 下载）──
# 复用 service-kit /storage 适配器配置（S3/OSS）
