root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# C++（client / server-sidecar）：4 空格
[*.{c,cc,cpp,cxx,h,hh,hpp,hxx}]
indent_size = 4

# CMake
[{CMakeLists.txt,*.cmake}]
indent_size = 4

# Markdown 保留行尾空格（换行语义）
[*.md]
trim_trailing_whitespace = false
