# yunzone-infer server 环境变量样例（复制为 .env 后填写；.env 禁止入库）
# 生态集成经 service-kit /config env facets（DESIGN §5）

# ── 部署面（D11 自托管 standalone；service-kit resolveListenAddress）──
PORT=3002
HOST=0.0.0.0

# ── 鉴权中心（/auth：机器凭证 / 推理请求 introspect，V3）──
# 未配置：控制通道放行 + 进程级一次性告警（开发/CI 态；生产必须配置）
AUTH_CENTER_BASE_URL=
# 鉴权中心 B 端服务凭证（introspect 全量视图；可选）
AUTH_SERVICE_CREDENTIAL=
# 机器凭证 productId 白名单（配置后控制通道凭证必须匹配，防跨产品凭证）
INFER_AUTH_PRODUCT_ID=

# ── 管理控制台（/ops/next requireAdminAuth）──
ADMIN_PASSWORD=

# ── 数据库（/db：注册信息 / 工作流状态 / 任务账）──
# P2 持久化（write-through + 启动恢复）：未配置 → 内存模式 + 一次性告警（重启丢失）；
# 配置但连不上 → 启动 fail-fast（部署错误）
DATABASE_URL=

# ── 结果保质期（shelf_life，D8/P2：终态结果签名收口）──
# 终态工作流结果可取回时长（毫秒，默认 24h）；超期后结果端点 410 E_SHELF_LIFE_EXPIRED；
# 对象物理清理交 S3 lifecycle（运维面）
INFERENCE_SHELF_LIFE_MS=86400000

# ── 执行面 sidecar IPC（D16：HTTP over loopback TCP + 每次启动随机 token）──
# 二进制路径（CMake 构建产物）；未设置则不拉起 sidecar（CI / 纯单测 / 外部自管）
SIDECAR_BIN=
# 0 = 随机端口，server 拉起 sidecar 后从 stderr 监听行回读；SIDECAR_TOKEN 由 server 启动时随机生成注入，勿在此固定
SIDECAR_PORT=0

# ── 数据面总线（D20/V8，P1 正式化：kit /storage 预签名）──
# S3 配置齐（S3_ENDPOINT_URL + S3_BUCKET_NAME）→ 预签名 URL；未配置 → 本地替身直链 + 告警
# 本地对拍（MinIO）：docker run -d --name infer-minio -p 9000:9000 minio/minio server /data
#（桶名需与 S3_BUCKET_NAME 一致；access/secret 走 S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY）
STORAGE_PROVIDER=s3
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 签名时效秒（默认 3600；过期风险由过量注入吸收 + TTL 判死重派重签兜底）
INFERENCE_BUS_URL_TTL_S=3600
# 替身形态的直链前缀（S3 未配置时生效）
INFERENCE_BUS_BASE_URL=http://127.0.0.1:43120

# ── 对象存储（/storage：DCIr 打包模型产物；D20 控制面签发预签名 URL 供 client 下载）──
# 复用上方 S3 变量组（service-kit /storage 适配器：STORAGE_PROVIDER / S3_*）
